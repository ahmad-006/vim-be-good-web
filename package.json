{
  "name": "vim-be-good-web",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "vite": "./bin/vite.js"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "vite": "bun ./bin/vite.js",
    "lint": "vp lint",
    "preview": "vp preview",
    "prepare": "vp config || true",
    "postinstall": "ln -sf ../../bin/vite.js node_modules/.bin/vite 2>/dev/null || true"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "canvas-confetti": "^1.9.4",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
